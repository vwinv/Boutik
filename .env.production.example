NODE_ENV=production
PUBLIC_ORIGIN=https://boutik.com
API_URL=https://boutik.com
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=
# Meta Embedded Signup : même origine que PUBLIC_ORIGIN (un seul domaine chez Meta)
# NEXT_PUBLIC_WHATSAPP_EMBEDDED_ORIGIN=https://boutik.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/boutik?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Boutik <contact@example.com>
