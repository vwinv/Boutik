{
  "name": "boutik",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "dotenv -e .env -e .env.development -e .env.development.local -o -- turbo dev --filter=@boutik/api --filter=@boutik/marketing --filter=@boutik/admin --filter=@boutik/app --filter=@boutik/web",
    "build": "NODE_ENV=production turbo build",
    "start": "NODE_ENV=production turbo start --filter=@boutik/api --filter=@boutik/marketing --filter=@boutik/admin --filter=@boutik/app --filter=@boutik/web",
    "test": "dotenv -e .env.test -- node -e \"require('assert').equal(process.env.NODE_ENV,'test'); require('assert').ok(process.env.DATABASE_URL.includes('boutik_test')); console.log('env test ok');\"",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @boutik/api prisma generate",
    "db:migrate": "dotenv -e .env -e .env.development -e .env.development.local -o -- pnpm --filter @boutik/api prisma migrate dev",
    "db:migrate:test": "dotenv -e .env.test -- pnpm --filter @boutik/api prisma migrate deploy",
    "db:migrate:deploy": "pnpm --filter @boutik/api prisma migrate deploy",
    "db:push": "dotenv -e .env -e .env.development -e .env.development.local -o -- pnpm --filter @boutik/api prisma db push",
    "db:seed": "dotenv -e .env -e .env.development -e .env.development.local -o -- pnpm --filter @boutik/api prisma db seed",
    "db:studio": "dotenv -e .env -e .env.development -e .env.development.local -o -- pnpm --filter @boutik/api prisma studio"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
