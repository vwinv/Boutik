# Copier vers .env.local pour des overrides personnels (non commité).
# Les valeurs par environnement : .env.development, .env.test, .env.production.example

NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
# Prod (Vercel marketing) — origines des autres déploiements pour rewrites /app /admin /api
# APP_ORIGIN=https://boutik-app.vercel.app
# ADMIN_ORIGIN=https://boutik-admin.vercel.app

LOG_LEVEL=debug
CORS_ORIGINS=
DATABASE_URL=postgresql://mac@localhost:5432/boutik?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Access JWT (ex. 86400 = 24 h). En local, .env.development peut écraser cette valeur.
JWT_ACCESS_TTL_SECONDS=86400
# Refresh JWT (ex. 2592000 = 30 j) — prolonge la session sans se reconnecter
JWT_REFRESH_TTL_SECONDS=2592000
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Boutik <contact@example.com>
# SoftPay PayDunya : true = Wave/OM/MTN · false = COD seulement
PAYDUNYA_ENABLED=false
PAYDUNYA_MODE=test
PAYDUNYA_COUNTRY=ci
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_STORE_NAME=Boutik
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_ROOT=Boutik
# eSMS Africa — OTP + notifications commande (module SMS)
ESMS_ENABLED=false
ESMS_API_KEY=
ESMS_SENDER_ID=Boutik
ESMS_BASE_URL=https://sms.esmsafrica.io
# WhatsApp Cloud API — webhook verify (tokens d’accès par boutique en base)
WHATSAPP_VERIFY_TOKEN=boutik-whatsapp-verify
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_URL=https://graph.facebook.com
# Embedded Signup — connexion commerçant one-click (Facebook Login for Business)
# 1) App Settings → Basic → App ID + App Secret
# 2) Facebook Login for Business → Configurations → template WhatsApp Embedded Signup → Configuration ID
# 3) Meta domaines : uniquement l’origine plateforme (PUBLIC_ORIGIN), PAS admin.{slug}.*
#    App Domains = boutik.com · Allowed JS SDK = https://boutik.com · redirect = login_success.html
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Origine HTTPS unique pour Meta (défaut = PUBLIC_ORIGIN). En local : tunnel trycloudflare.
NEXT_PUBLIC_WHATSAPP_EMBEDDED_ORIGIN=
